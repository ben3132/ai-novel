# ===== 数据库连接 =====
# 与 docker-compose 中 POSTGRES_* 对应；端口改过就同步改这里
# 请把 <user>/<password>/<dbname> 换成自己的值（与 docker-compose.yml 或既有 PG 实例一致）
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<dbname>

# ===== OpenAI 兼容 LLM / Embedding =====
# 默认指向 OpenAI 官方；可换成任意 OpenAI 兼容网关（DeepSeek/通义/自建 vLLM 等）
# 注意：此处留空即表示"未配置 LLM"，ETL/wb_tools 将自动走 --mock 确定性降级；
#       填真实 key 后走真实 API（不要填占位符，否则会被当成有效 key 去联网）。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 结构化提取所用的 chat 模型
EXTRACT_MODEL=gpt-4o-mini
# embedding 模型，维度必须与 schema 的 vector(1536) 一致
EMBED_MODEL=text-embedding-3-small
# 向量维度（改 embedding 模型维度时，必须同步修改 init.sql 中的 vector(1536)）
EMBED_DIM=1536
# 单次 embedding API 请求的最大条数
EMBED_BATCH_SIZE=64
# 检索/提取时给 LLM 的最大 token 预算
MAX_CONTEXT_TOKENS=8000

# ===== 搜索补全 API（世界设定低置信度联网核对） =====
# 占位：按实际 provider 填写（如 Tavily/Serper/Bing），etl.py 提供示例实现
SEARCH_API_KEY=
SEARCH_API_BASE_URL=https://api.tavily.com/search

# ===== ETL 时间分布（v1.1：外化配置适配不同篇幅稿件） =====
# 基准时刻：ISO8601 建议带时区；默认 now=导入时刻。
# 建议固定一个 ISO 值，例如 ETL_TIME_BASE=2026-01-01T00:00:00+08:00，
# 使任何重跑产生完全一致的时间戳（幂等 + 分区稳定）。
ETL_TIME_BASE=now
# 整稿时间跨度（天，float，>=0；0=全部同一时刻）。
# 短稿几十章用默认 1；数千章长篇或希望跨多个月分区时调大（如 180 = 半年跨度）。
ETL_TIME_SPAN_DAYS=1.0

# ===== 其他 =====
# Python 侧日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO
TZ=Asia/Shanghai
