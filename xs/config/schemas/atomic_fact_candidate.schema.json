{
  "description": "模型或规则输出只能先成为候选，不能直接成为正式设定。",
  "properties": {
    "fact_id": {
      "title": "Fact Id",
      "type": "string"
    },
    "subject": {
      "title": "Subject",
      "type": "string"
    },
    "predicate": {
      "title": "Predicate",
      "type": "string"
    },
    "object": {
      "title": "Object",
      "type": "string"
    },
    "fact_type": {
      "enum": [
        "attribute",
        "relationship",
        "event",
        "identity",
        "possession",
        "membership",
        "state_change"
      ],
      "title": "Fact Type",
      "type": "string"
    },
    "work_id": {
      "title": "Work Id",
      "type": "string"
    },
    "chapter_id": {
      "title": "Chapter Id",
      "type": "string"
    },
    "window_id": {
      "title": "Window Id",
      "type": "string"
    },
    "evidence_text": {
      "title": "Evidence Text",
      "type": "string"
    },
    "evidence_window_start": {
      "title": "Evidence Window Start",
      "type": "integer"
    },
    "evidence_window_end": {
      "title": "Evidence Window End",
      "type": "integer"
    },
    "evidence_unit_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Unit Ids",
      "type": "array"
    },
    "polarity": {
      "default": "positive",
      "enum": [
        "positive",
        "negative"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "certainty": {
      "default": "explicit",
      "enum": [
        "explicit",
        "reported",
        "uncertain",
        "hypothetical"
      ],
      "title": "Certainty",
      "type": "string"
    },
    "qualifiers": {
      "additionalProperties": true,
      "title": "Qualifiers",
      "type": "object"
    },
    "trust_level": {
      "enum": [
        1,
        2,
        3,
        4,
        11
      ],
      "title": "Trust Level",
      "type": "integer"
    },
    "extraction_method": {
      "title": "Extraction Method",
      "type": "string"
    },
    "model_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Name"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "status": {
      "const": "candidate",
      "default": "candidate",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "fact_id",
    "subject",
    "predicate",
    "object",
    "fact_type",
    "work_id",
    "chapter_id",
    "window_id",
    "evidence_text",
    "evidence_window_start",
    "evidence_window_end",
    "trust_level",
    "extraction_method"
  ],
  "title": "AtomicFactCandidate",
  "type": "object"
}
